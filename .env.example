# Copiez ce fichier en ".env" (jamais versionné) pour le test "npm run smoke"
# ou pour lancer le serveur avec : node --env-file=.env dist/index.js

# --- Connexion (obligatoire) ---
# Formes acceptées : hote | hote,port | hote\instance
MSSQL_SERVER=sql.mon-entreprise.fr
MSSQL_USER=claude_lecteur
MSSQL_PASSWORD=changez-moi

# --- Connexion (optionnel) ---
# MSSQL_PORT=1433
# MSSQL_INSTANCE=SQLEXPRESS
# MSSQL_DEFAULT_DATABASE=master
# MSSQL_ENCRYPT=true
# Mettre à true si le serveur utilise un certificat auto-signé (cas fréquent en interne)
# MSSQL_TRUST_SERVER_CERTIFICATE=false
# MSSQL_CONNECT_TIMEOUT_MS=15000
# MSSQL_QUERY_TIMEOUT_MS=60000

# --- Sécurité et limites (optionnel) ---
# MSSQL_READONLY=true
# MSSQL_DEFAULT_ROWS=100
# MSSQL_MAX_ROWS=1000
# MSSQL_MAX_CELL_LENGTH=1000

# --- Filtrage des bases visibles (optionnel) ---
# MSSQL_DATABASES=Ventes,RH
# MSSQL_EXCLUDED_DATABASES=Archives
# MSSQL_INCLUDE_SYSTEM_DATABASES=false
