{
  "name": "mcp-sqlserver",
  "version": "1.0.0",
  "description": "Serveur MCP pour connecter Claude (Desktop / Code) à un SQL Server distant",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-sqlserver": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test \"test/*.test.mjs\"",
    "smoke": "tsc && node scripts/smoke-test.mjs",
    "install-desktop": "tsc && node scripts/install-claude-desktop.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mssql": "^12.7.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
